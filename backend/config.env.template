# Stock Trading Simulator — C++ backend configuration
# Copy to config.env and source it before running, or set these as Docker env vars.

# Path for the SQLite database file
DB_PATH=stock_simulator.db

# Alpha Vantage API key — https://www.alphavantage.co/support/#api-key
MARKET_API_KEY=YOUR_ALPHA_VANTAGE_API_KEY_HERE

# Alpha Vantage base URL (no trailing slash)
MARKET_API_URL=https://www.alphavantage.co

# Path to the built React frontend (relative to the binary)
STATIC_DIR=../demo/src/main/resources/static/frontend/build

# HTTP port
PORT=8080
